# Keep the serverless bundle small: ship the code and the slim database only.
.venv/
__pycache__/
.pytest_cache/
tests/
scripts/
docs/
notebooks/

# Raw CSVs (~19 MB) are build inputs, not runtime inputs.
data/raw/
# The full local database; the slim deploy artefact is included via vercel.json.
data/processed/olxads.db
# The DuckDB warehouse is build-time only — its results already live in the
# deploy artefact as olap_* tables.
data/processed/olxads.duckdb
data/processed/opportunity_scores.csv

web/node_modules/
