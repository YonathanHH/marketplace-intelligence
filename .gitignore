.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/

# Full local database (~67 MB) — rebuild with `python run.py --rebuild`.
# The slim deployment artefact (data/processed/olxads-deploy.db) IS committed,
# because Vercel deploys from git and the function needs it at runtime.
data/processed/olxads.db

# DuckDB OLAP warehouse (~10 MB). Build-time only — its results are materialised
# into SQLite as olap_* tables, which ship inside the deploy artefact.
data/processed/olxads.duckdb

# Frontend
web/node_modules/
web/dist/

# Vercel
.vercel/

# Cached Natural Earth download for scripts/build_geo.py
# (the built asset web/src/data/indonesia.json IS committed)
.tmpgeo/

# Taste-skill working files: direction sheets, before/after renders, gate reports
.taste-skill/
